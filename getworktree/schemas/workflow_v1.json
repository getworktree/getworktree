{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getworktree.io/schemas/workflow_v1.json",
  "title": "Worktree Workflow Definition V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "description",
    "iteration",
    "sandbox",
    "approval",
    "context",
    "patch"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_id"],
            "properties": {
              "step_id": { "type": "string", "minLength": 1 },
              "override_timeout_seconds": { "type": "integer", "minimum": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "type": {
                "type": "string",
                "enum": ["command", "agent", "script"]
              },
              "description": { "type": "string" },
              "command": { "type": "string" },
              "args": {
                "type": "array",
                "items": { "type": "string" }
              },
              "prompt": { "type": "string" },
              "agent": { "type": "string" },
              "tools": {
                "type": "array",
                "items": { "type": "string" }
              },
              "script_path": { "type": "string" },
              "timeout_seconds": { "type": "integer", "minimum": 1 },
              "failure_action": {
                "type": "string",
                "enum": ["abort", "ignore", "retry"]
              }
            }
          }
        ]
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args", "timeout_seconds"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "mode", "timeout_seconds"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["local", "ollama", "cursor", "gemini", "copilot"]
        },
        "mode": {
          "type": "string",
          "enum": ["fix_failure", "review_remediation"]
        },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "iteration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "stop_when"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1 },
        "stop_when": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["trigger_passes", "unfixable", "user_abort"]
          }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto_clean", "keep_on_failure"],
      "properties": {
        "auto_clean": { "type": "boolean" },
        "keep_on_failure": { "type": "boolean" },
        "use_git_worktree": { "type": "boolean", "default": true }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["require_before_apply"],
      "properties": {
        "require_before_apply": { "type": "boolean" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["trigger_output", "changed_files", "relevant_source"]
          }
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "max_files", "max_patch_kb"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["unified_diff"]
        },
        "max_files": { "type": "integer", "minimum": 1 },
        "max_patch_kb": { "type": "integer", "minimum": 1 },
        "reject_binary_changes": { "type": "boolean" }
      }
    }
  }
}